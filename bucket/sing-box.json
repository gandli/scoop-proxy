{
    "version": "1.14.4",
    "description": "The universal proxy platform.",
    "homepage": "https://github.com/SagerNet/sing-box",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://github.com/SagerNet/sing-box/blob/dev-next/LICENSE"
    },
    "notes": [
        "If you want to use TUN mode, please run sing-box with administrator privileges.",
        "Your configuration and cache files are persisted in '$persist_dir'.",
        "You can run with a directory of configs using: 'sing-box run -C $persist_dir\\config.d'"
    ],
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item -Path \"$persist_dir\" -ItemType Directory | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\config.json\")) {",
        "    $utf8NoBom = New-Object System.Text.UTF8Encoding($false)",
        "    [System.IO.File]::WriteAllText(\"$persist_dir\\config.json\", \"{}\", $utf8NoBom)",
        "}"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/SagerNet/sing-box/releases/download/v1.14.4/sing-box-1.14.4-windows-amd64.zip",
            "hash": "99185d75d314a07dbba4a130c8ad986cbeb629a07927975636b341ca61f991df",
            "extract_dir": "sing-box-1.14.4-windows-amd64",
            "bin": "sing-box.exe"
        },
        "arm64": {
            "url": "https://github.com/SagerNet/sing-box/releases/download/v1.14.4/sing-box-1.14.4-windows-arm64.zip",
            "hash": "8cd0a4d0cd8cd480be5731ac31f17038969a42d12add9feb6e031fd43d85bbae",
            "extract_dir": "sing-box-1.14.4-windows-arm64",
            "bin": "sing-box.exe"
        }
    },
    "bin": "sing-box.exe",
    "persist": [
        "config",
        "config.d",
        "config.json",
        "cache.db"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-amd64.zip",
                "extract_dir": "sing-box-$version-windows-amd64"
            },
            "arm64": {
                "url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-arm64.zip",
                "extract_dir": "sing-box-$version-windows-arm64"
            }
        }
    }
}
